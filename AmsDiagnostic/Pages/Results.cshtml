@page
@model AmsDiagnostic.Pages.ResultsModel
@{
    Layout = "_ResultsLayout";
    ViewData["Title"] = "AMS Diagnostic Results";
}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
<div class="results-container">
    <div class="results-card">
        <div class="results-header">
            <img src="~/img/ams-diagnostic-header.png.png" alt="Your AMS Success Diagnostic Results" />
        </div>
        <div class="results-body">
            <div class="pill-container">
                <button class="diagnostic-pill active" data-section="summary">
                    <span class="pill-number">1</span>
                    <span>Summary</span>
                </button>
                <button class="diagnostic-pill" data-section="foundation">
                    <span class="pill-number">2</span>
                    <span>Foundation</span>
                </button>
                <button class="diagnostic-pill" data-section="success-factors">
                    <span class="pill-number">3</span>
                    <span>Success Factors</span>
                </button>
                <button class="diagnostic-pill" data-section="action">
                    <span class="pill-number">4</span>
                    <span>Action Plan</span>
                </button>
            </div>
            <div class="sub-pill-container" id="success-factors-subpills" style="display: none;">
                <button class="diagnostic-sub-pill" data-section="alignment">
                    <span class="pill-number">3.1</span>
                    <span>Alignment</span>
                </button>
                <button class="diagnostic-sub-pill" data-section="adoption">
                    <span class="pill-number">3.2</span>
                    <span>Adoption</span>
                </button>
                <button class="diagnostic-sub-pill" data-section="performance">
                    <span class="pill-number">3.3</span>
                    <span>Performance Optimization</span>
                </button>
                <button class="diagnostic-sub-pill" data-section="improvement">
                    <span class="pill-number">3.4</span>
                    <span>Continuous Improvement</span>
                </button>
            </div>

            <!-- Success Factors Alert (shown only when Success Factors is active) -->
            <div id="success-factors-alert" class="alert alert-info" style="display: none;">
                <h5 class="alert-heading">About Success Factors</h5>
                <p class="mb-0">Success Factors represent the four critical dimensions that drive AMS effectiveness: Alignment, Adoption, Performance Optimization, and Continuous Improvement. These interconnected areas determine your overall AMS maturity and business impact.</p>
            </div>

            <div class="content-area">
                <!-- SUMMARY SECTION -->
                <div id="content-summary" class="content-section">
                    <!-- Summary Option 1: High Performance -->
                    <div class="summary-option" data-option="high" style="display: block;">
                        <div class="summary-content-wrapper">
                            <div class="summary-text">
                                <h2>Your AMS Foundation is Strong. Time to Accelerate.</h2>
                                <p>Congratulations! You've done the hard work of building a solid AMS foundation, and your organization is positioned to leverage your system as a true strategic asset.</p> 
                                <p>The opportunity ahead isn't about fixing problems; it's about capitalizing on momentum and staying ahead of the curve.</p>
                            </div>
                            <div class="summary-image">
                                <img src="~/img/summary.png" alt="Success and Growth" />
                            </div>
                        </div>
                    </div>

                    <!-- Summary Option 2: Medium Performance -->
                    <div class="summary-option" data-option="medium" style="display: none;">
                        <div class="summary-content-wrapper">
                            <div class="summary-text">
                                <h2>You're On the Right Track. Clear Opportunities Ahead. </h2>
<p>You're past the survival stage and ready for the optimizations that deliver measurable impact.</p>
<p>The path forward is clear: targeted improvements that compound over time.</p>
<p>Now it's about strategic refinement, not firefighting.</p>
                            </div>
                            <div class="summary-image">
                                <img src="~/img/summary.png" alt="Success and Growth" />
                            </div>
                        </div>
                    </div>

                    <!-- Summary Option 3: Low Performance -->
                    <div class="summary-option" data-option="low" style="display: none;">
                        <div class="summary-content-wrapper">
                            <div class="summary-text">
                                <h2>You've Identified the Gaps. Time to Close Them. </h2>
<p>Every high-performing AMS implementation started exactly where you are. The difference is having a clear roadmap and the right support.</p> 
<p>You've taken the critical first step by understanding where the opportunities and gaps lie.  </p>
<p>You're in the perfect position to transform your AMS from "just a database" into a competitive advantage. </p>

                            </div>
                            <div class="summary-image">
                                <img src="~/img/summary.png" alt="Success and Growth" />
                            </div>
                        </div>
                    </div>
                </div>

                <!-- FOUNDATION SECTION -->
                <div id="content-foundation" class="content-section" style="display: none;">
                    <!-- Foundation High Performance -->
                    <div class="summary-option" data-option="high" style="display: block;">
                        <div class="summary-content-wrapper">
                            <div class="summary-text">
                                <h2>Foundation is Solid, Time to Scale</h2>

                                <h4>Where You Stand</h4>
                                <p>Your foundational elements are solid. You have the basic infrastructure in place to support take your AMS success to the next level. </p>

                                <h4>The Opportunity</h4>
                                <p>With strong fundamentals, you can focus on optimization and innovation rather than firefighting. Your foundation supports sustainable growth. </p>

                                <h4>Next Steps and Quick Wins</h4>
                                <ul>
                                    <li class="py-2">Identify one or two opportunities to use AI to simplify business processes </li>
                                    <li class="py-2">Mine member engagement data to reveal hidden areas of interest to use for marketing, education and community discussion topics  </li>
                                    <li class="py-2">Investigate additional ways to enable AMS functional</li>
                                </ul>
                            </div>
                            <div class="summary-image">
                                <img src="~/img/foundation.png" alt="Foundation" />
                            </div>
                        </div>
                    </div>

                    <!-- Foundation Medium Performance -->
                    <div class="summary-option" data-option="medium" style="display: none;">
                        <div class="summary-content-wrapper">
                            <div class="summary-text">
                                <h2>Foundation in Progress, Time to Close Gaps </h2>

                                <h4>Where You Stand</h4>
                                <p>You have some foundational elements in place, but there are gaps that could limit your future success.</p>

                                <h4>The Opportunity</h4>
                                <p>Strengthening your foundation now prevents bigger problems later. Small investments in fundamentals create exponential returns. </p>

                                <h4>Next Steps and Quick Wins</h4>
                                <ul>
                                    <li class="py-2">Create (or update) SOPs for areas that routinely cause confusion or avoidance </li>
                                    <li class="py-2">Create (or revive) a cross-departmental stakeholder alliance to provide governance for the AMS and amplify the importance of using it to its full capabilities </li>
                                    <li class="py-2">Initiate a data cleanup calendar, timed to help ensure data is accurate prior to large outreach initiatives (e.g. membership renewals, opening annual conference registration)</li>
                                </ul>

                            </div>
                            <div class="summary-image">
                                <img src="~/img/foundation.png" alt="Foundation" />
                            </div>
                        </div>
                    </div>

                    <!-- Foundation Low Performance -->
                    <div class="summary-option" data-option="low" style="display: none;">
                        <div class="summary-content-wrapper">
                            <div class="summary-text">
                                <h2>Time to Build a Lasting Foundation</h2>

                                <h4>Where You Stand</h4>
                                <p>Your foundational elements need attention. Without these building blocks, other improvements will be difficult to implement and sustain.</p>

                                <h4>The Opportunity</h4>
                                <p>Addressing foundational gaps creates immediate relief and unlocks everything else. This is where the biggest quick wins live. </p>

                                <h4>Next Steps and Quick Wins</h4>
                                <ul>
<li class="py-2">Prepare for future upgrades; create onea calendar to track upgrade dates and document replicable testing processes </li>
<li class="py-2">Build a feedback loop and resolution process to receive AMS issues and wish list items </li>
<li class="py-2">Create and execute a communication campaign to share new features in your AMS and (at least) monthly tips and tricks </li>
 
                                </ul>
                            </div>
                            <div class="summary-image">
                                <img src="~/img/foundation.png" alt="Foundation" />
                            </div>
                        </div>
                    </div>
                </div>

                <!-- SUCCESS FACTORS OVERVIEW SECTION -->
                <div id="content-success-factors" class="content-section" style="display: none;">
                    <h2>Success Factors Overview</h2>
                    <p>The Success Factors represent critical dimensions that drive AMS effectiveness. These four interconnected areas determine your overall AMS maturity and impact.</p>

                    <h4>Composite Score: 68/100</h4>

                    <div style="margin-top: 1.5rem;">
                        <p><strong>Select a specific success factor above to view detailed analysis:</strong></p>
                        <ul>
                            <li><strong>3.1 Alignment:</strong> Strategic and operational alignment across the organization</li>
                            <li><strong>3.2 Adoption:</strong> User engagement and system utilization rates</li>
                            <li><strong>3.3 Performance Optimization:</strong> Efficiency metrics and continuous improvement</li>
                            <li><strong>3.4 Continuous Improvement:</strong> Feedback loops and iterative enhancement</li>
                        </ul>
                    </div>
                </div>

                <!-- 3.1 ALIGNMENT SECTION -->
                <div id="content-alignment" class="content-section" style="display: none;">
                    <!-- Alignment High -->
                    <div class="summary-option" data-option="high" style="display: block;">
                        <div class="summary-content-wrapper">
                            <div class="summary-text">
                    <h2>Everyone’s on Board, Time for Leverage</h2>

                    <h4>Where You Stand</h4>
                    <p>Your organization demonstrates strong alignment around AMS strategy, ownership, and priorities. Leadership and staff are on the same page. </p>

            <div id="success-factors-alert" class="alert alert-info" style="margin-top: 1.5rem;">
                    <h4>The Opportunity</h4>
                    <p>Leverage this alignment to tackle more ambitious initiatives. Your unified approach enables faster decision-making and smoother execution.</p>
</div>
                    <h4>Next Steps and Quick Wins</h4>
                    <ul class="list-unstyled">
  <li class="py-2 ps-3"><i class="bi bi-check-circle-fill text-success me-2"></i><strong>Strategic Alignment</strong>: Map your AMS’ capabilities to strategic priorities and add them to the overarching strategic roadmap </li>
  <li class="py-2 ps-3"><i class="bi bi-check-circle-fill text-success me-2"></i><strong>Stakeholder Alignment:</strong> Initiate monthly/quarterly department head alignment sessions to ensure the AMS remains a leadership priority </li>
  <li class="py-2 ps-3"><i class="bi bi-check-circle-fill text-success me-2"></i><strong>Resource Alignment:</strong> Prioritize AMS optimization as an ongoing, critical budget item</li>
</ul>

                            </div>
                            <div class="summary-image">
                                <img src="~/img/alignment.png" alt="Alignment" />
                            </div>
                        </div>
                    </div>

                    <!-- Alignment Medium -->
                    <div class="summary-option" data-option="medium" style="display: none;">
                        <div class="summary-content-wrapper">
                            <div class="summary-text">
                                <h2>3.1 Alignment - Medium Performance</h2>
                                <p>Good alignment overall with opportunities to strengthen strategic connections.</p>

                                <h4>Score: 72/100</h4>

                                <h4>Strategic Alignment:</h4>
                                <ul>
                                    <li><strong>Executive Sponsorship:</strong> Good - Leadership supports initiatives</li>
                                    <li><strong>Business Objectives:</strong> Mostly aligned - Some gaps in strategic clarity</li>
                                    <li><strong>Cross-functional Collaboration:</strong> Functional but could be stronger</li>
                                    <li><strong>Customer Focus:</strong> Customer needs considered but not always prioritized</li>
                                </ul>

                                <h4>Recommendations:</h4>
                                <ol>
                                    <li>Establish quarterly business review process</li>
                                    <li>Create alignment scorecards</li>
                                    <li>Strengthen executive engagement</li>
                                </ol>
                            </div>
                            <div class="summary-image">
                                <img src="~/img/alignment.png" alt="Alignment" />
                            </div>
                        </div>
                    </div>

                    <!-- Alignment Low -->
                    <div class="summary-option" data-option="low" style="display: none;">
                        <div class="summary-content-wrapper">
                            <div class="summary-text">
                                <h2>3.1 Alignment - Needs Improvement</h2>
                                <p>Alignment is weak. Strengthening strategic connections is critical for success.</p>

                                <h4>Score: 42/100</h4>

                                <h4>Alignment Gaps:</h4>
                                <ul>
                                    <li><strong>Executive Sponsorship:</strong> Limited - Needs stronger leadership buy-in</li>
                                    <li><strong>Business Objectives:</strong> Disconnected from strategy</li>
                                    <li><strong>Cross-functional Collaboration:</strong> Siloed operations</li>
                                    <li><strong>Customer Focus:</strong> Internal focus prevails</li>
                                </ul>

                                <h4>Priority Actions:</h4>
                                <ol>
                                    <li>Secure executive sponsor immediately</li>
                                    <li>Map AMS goals to business objectives</li>
                                    <li>Launch cross-functional alignment workshops</li>
                                    <li>Implement customer-centric KPIs</li>
                                </ol>
                            </div>
                            <div class="summary-image">
                                <img src="~/img/alignment.png" alt="Alignment" />
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 3.2 ADOPTION SECTION -->
                <div id="content-adoption" class="content-section" style="display: none;">
                    <!-- Adoption High -->
                    <div class="summary-option" data-option="high" style="display: block;">
                        <div class="summary-content-wrapper">
                            <div class="summary-text">
                                <h2>3.2 Adoption - High Performance</h2>
                                <p>Excellent! User adoption is strong, demonstrating high engagement and value realization.</p>

                                <h4>Score: 87/100</h4>

                                <h4>Usage Metrics:</h4>
                                <ul>
                                    <li><strong>Active Users:</strong> 92% - Well above target</li>
                                    <li><strong>Daily Engagement:</strong> Excellent - 5+ hours average usage</li>
                                    <li><strong>Feature Utilization:</strong> High - Advanced features widely used</li>
                                    <li><strong>User Satisfaction:</strong> 8.8/10 - Strong positive sentiment</li>
                                </ul>

                                <h4>Recommendations:</h4>
                                <ol>
                                    <li>Document and share adoption success factors</li>
                                    <li>Continue user feedback programs</li>
                                    <li>Explore advanced feature adoption opportunities</li>
                                </ol>
                            </div>
                            <div class="summary-image">
                                <img src="~/img/adoption.png" alt="Adoption" />
                            </div>
                        </div>
                    </div>

                    <!-- Adoption Medium -->
                    <div class="summary-option" data-option="medium" style="display: none;">
                        <div class="summary-content-wrapper">
                            <div class="summary-text">
                                <h2>3.2 Adoption - Medium Performance</h2>
                                <p>Moderate adoption with clear opportunities to increase engagement and utilization.</p>

                                <h4>Score: 68/100</h4>

                                <h4>Usage Metrics:</h4>
                                <ul>
                                    <li><strong>Active Users:</strong> 68% - Below target of 85%</li>
                                    <li><strong>Daily Engagement:</strong> Fair - 2-3 hours average</li>
                                    <li><strong>Feature Utilization:</strong> Basic features used, advanced underutilized</li>
                                    <li><strong>User Satisfaction:</strong> 7.2/10 - Room for improvement</li>
                                </ul>

                                <h4>Recommendations:</h4>
                                <ol>
                                    <li>Launch adoption campaign for advanced features</li>
                                    <li>Implement role-specific training</li>
                                    <li>Establish power user program</li>
                                    <li>Address usability pain points</li>
                                </ol>
                            </div>
                            <div class="summary-image">
                                <img src="~/img/adoption.png" alt="Adoption" />
                            </div>
                        </div>
                    </div>

                    <!-- Adoption Low -->
                    <div class="summary-option" data-option="low" style="display: none;">
                        <div class="summary-content-wrapper">
                            <div class="summary-text">
                                <h2>3.2 Adoption - Needs Attention</h2>
                                <p>Low adoption is limiting AMS value. Urgent action needed to drive engagement.</p>

                                <h4>Score: 38/100</h4>

                                <h4>Adoption Challenges:</h4>
                                <ul>
                                    <li><strong>Active Users:</strong> 42% - Critically low</li>
                                    <li><strong>Daily Engagement:</strong> Poor - Minimal usage</li>
                                    <li><strong>Feature Utilization:</strong> Very limited</li>
                                    <li><strong>User Satisfaction:</strong> 5.1/10 - Significant issues</li>
                                </ul>

                                <h4>Critical Actions:</h4>
                                <ol>
                                    <li>Conduct user research to identify barriers</li>
                                    <li>Redesign onboarding and training</li>
                                    <li>Address major usability issues</li>
                                    <li>Implement change management program</li>
                                    <li>Create incentives for adoption</li>
                                </ol>
                            </div>
                            <div class="summary-image">
                                <img src="~/img/adoption.png" alt="Adoption" />
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 3.3 PERFORMANCE OPTIMIZATION SECTION -->
                <div id="content-performance" class="content-section" style="display: none;">
                    <!-- Performance High -->
                    <div class="summary-option" data-option="high" style="display: block;">
                        <div class="summary-content-wrapper">
                            <div class="summary-text">
                                <h2>3.3 Performance Optimization - High Performance</h2>
                                <p>Outstanding! Your AMS operations are highly efficient and effective.</p>

                                <h4>Score: 89/100</h4>

                                <h4>Efficiency Metrics:</h4>
                                <ul>
                                    <li><strong>Response Time:</strong> Excellent - Sub-2 hour average</li>
                                    <li><strong>Automation Rate:</strong> 78% - Industry-leading</li>
                                    <li><strong>Customer Satisfaction:</strong> 9.1/10</li>
                                    <li><strong>Retention Rate:</strong> 96%</li>
                                </ul>

                                <h4>Recommendations:</h4>
                                <ol>
                                    <li>Share performance best practices</li>
                                    <li>Continue optimization initiatives</li>
                                    <li>Explore AI-powered enhancements</li>
                                </ol>
                            </div>
                            <div class="summary-image">
                                <img src="~/img/optimization.png" alt="Performance Optimization" />
                            </div>
                        </div>
                    </div>

                    <!-- Performance Medium -->
                    <div class="summary-option" data-option="medium" style="display: none;">
                        <div class="summary-content-wrapper">
                            <div class="summary-text">
                                <h2>3.3 Performance Optimization - Medium Performance</h2>
                                <p>Good performance with clear opportunities for optimization.</p>

                                <h4>Score: 70/100</h4>

                                <h4>Efficiency Metrics:</h4>
                                <ul>
                                    <li><strong>Response Time:</strong> Good - 4 hour average</li>
                                    <li><strong>Automation Rate:</strong> 45% - Room for improvement</li>
                                    <li><strong>Customer Satisfaction:</strong> 8.1/10</li>
                                    <li><strong>Retention Rate:</strong> 92%</li>
                                </ul>

                                <h4>Recommendations:</h4>
                                <ol>
                                    <li>Identify top automation opportunities</li>
                                    <li>Implement performance dashboards</li>
                                    <li>Optimize workflow bottlenecks</li>
                                    <li>Reduce response times</li>
                                </ol>
                            </div>
                            <div class="summary-image">
                                <img src="~/img/optimization.png" alt="Performance Optimization" />
                            </div>
                        </div>
                    </div>

                    <!-- Performance Low -->
                    <div class="summary-option" data-option="low" style="display: none;">
                        <div class="summary-content-wrapper">
                            <div class="summary-text">
                                <h2>3.3 Performance Optimization - Needs Improvement</h2>
                                <p>Performance issues are impacting results. Focus on efficiency improvements.</p>

                                <h4>Score: 44/100</h4>

                                <h4>Performance Gaps:</h4>
                                <ul>
                                    <li><strong>Response Time:</strong> Poor - 12+ hour average</li>
                                    <li><strong>Automation Rate:</strong> 15% - Highly manual</li>
                                    <li><strong>Customer Satisfaction:</strong> 6.2/10</li>
                                    <li><strong>Retention Rate:</strong> 78%</li>
                                </ul>

                                <h4>Critical Actions:</h4>
                                <ol>
                                    <li>Automate top 10 manual processes</li>
                                    <li>Implement SLA tracking</li>
                                    <li>Address customer satisfaction issues</li>
                                    <li>Create performance improvement plan</li>
                                </ol>
                            </div>
                            <div class="summary-image">
                                <img src="~/img/optimization.png" alt="Performance Optimization" />
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 3.4 CONTINUOUS IMPROVEMENT SECTION -->
                <div id="content-improvement" class="content-section" style="display: none;">
                    <!-- Improvement High -->
                    <div class="summary-option" data-option="high" style="display: block;">
                        <div class="summary-content-wrapper">
                            <div class="summary-text">
                                <h2>3.4 Continuous Improvement - High Performance</h2>
                                <p>Excellent! Strong culture of learning and systematic improvement.</p>

                                <h4>Score: 86/100</h4>

                                <h4>Key Strengths:</h4>
                                <ul>
                                    <li><strong>Feedback Mechanisms:</strong> Robust - Multiple channels, quick action</li>
                                    <li><strong>Innovation Culture:</strong> Strong experimentation mindset</li>
                                    <li><strong>Iteration Speed:</strong> Fast - 4-6 week improvement cycles</li>
                                    <li><strong>Knowledge Management:</strong> Well-documented and shared</li>
                                </ul>

                                <h4>Recommendations:</h4>
                                <ol>
                                    <li>Share improvement framework across organization</li>
                                    <li>Continue rapid iteration approach</li>
                                    <li>Maintain innovation programs</li>
                                </ol>
                            </div>
                            <div class="summary-image">
                                <img src="~/img/improvement.png" alt="Continuous Improvement" />
                            </div>
                        </div>
                    </div>

                    <!-- Improvement Medium -->
                    <div class="summary-option" data-option="medium" style="display: none;">
                        <div class="summary-content-wrapper">
                            <div class="summary-text">
                                <h2>3.4 Continuous Improvement - Medium Performance</h2>
                                <p>Basic improvement processes in place with opportunities to accelerate.</p>

                                <h4>Score: 64/100</h4>

                                <h4>Current State:</h4>
                                <ul>
                                    <li><strong>Feedback Mechanisms:</strong> Ad-hoc collection, needs structure</li>
                                    <li><strong>Innovation Culture:</strong> Risk-averse, limited experimentation</li>
                                    <li><strong>Iteration Speed:</strong> Slow - 4-6 month cycles</li>
                                    <li><strong>Knowledge Management:</strong> Inconsistent documentation</li>
                                </ul>

                                <h4>Recommendations:</h4>
                                <ol>
                                    <li>Establish formal improvement framework</li>
                                    <li>Create quarterly improvement cycles</li>
                                    <li>Launch innovation lab</li>
                                    <li>Build knowledge management system</li>
                                </ol>
                            </div>
                            <div class="summary-image">
                                <img src="~/img/improvement.png" alt="Continuous Improvement" />
                            </div>
                        </div>
                    </div>

                    <!-- Improvement Low -->
                    <div class="summary-option" data-option="low" style="display: none;">
                        <div class="summary-content-wrapper">
                            <div class="summary-text">
                                <h2>3.4 Continuous Improvement - Needs Development</h2>
                                <p>Improvement processes are minimal. Build systematic approach to learning and adaptation.</p>

                                <h4>Score: 36/100</h4>

                                <h4>Major Gaps:</h4>
                                <ul>
                                    <li><strong>Feedback Mechanisms:</strong> None - No systematic collection</li>
                                    <li><strong>Innovation Culture:</strong> Reactive, change-resistant</li>
                                    <li><strong>Iteration Speed:</strong> Very slow - Annual or less</li>
                                    <li><strong>Knowledge Management:</strong> No documentation</li>
                                </ul>

                                <h4>Critical Actions:</h4>
                                <ol>
                                    <li>Implement feedback collection immediately</li>
                                    <li>Adopt Agile/Kaizen methodology</li>
                                    <li>Create improvement roadmap</li>
                                    <li>Build learning culture through training</li>
                                    <li>Document current processes as baseline</li>
                                </ol>
                            </div>
                            <div class="summary-image">
                                <img src="~/img/improvement.png" alt="Continuous Improvement" />
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ACTION PLAN SECTION -->
                <div id="content-action" class="content-section" style="display: none;">
                    <!-- Action Plan High -->
                    <div class="summary-option" data-option="high" style="display: block;">
                        <div class="summary-content-wrapper">
                            <div class="summary-text">
                                <h2>Action Plan - Optimization Focus</h2>
                                <p>Your strong foundation enables focus on advanced optimization and innovation.</p>

                                <h4>30-60 Days - Fine-Tuning:</h4>
                                <ol>
                                    <li>Launch advanced analytics initiative</li>
                                    <li>Explore AI/ML opportunities</li>
                                    <li>Share best practices internally</li>
                                </ol>

                                <h4>90-180 Days - Innovation:</h4>
                                <ol start="4">
                                    <li>Pilot predictive customer insights</li>
                                    <li>Implement advanced automation</li>
                                    <li>Launch innovation programs</li>
                                </ol>

                                <h4>Success Metrics:</h4>
                                <ul>
                                    <li>Maintain 90+ overall score</li>
                                    <li>Launch 3 innovation pilots</li>
                                    <li>Achieve 95%+ retention</li>
                                </ul>
