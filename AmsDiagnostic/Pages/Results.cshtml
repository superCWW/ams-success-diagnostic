@section Scripts {
    <script>
        $(document).ready(function() {
            console.log('Pills found:', $('.diagnostic-pill').length);
            console.log('Sub-pills found:', $('.diagnostic-sub-pill').length);

            // Main pill navigation
            $('.diagnostic-pill').on('click', function(e) {
                e.preventDefault();
                const section = $(this).data('section');
                console.log('Clicked main pill:', section);

                // Remove active class from all pills
                $('.diagnostic-pill').removeClass('active');
                $('.diagnostic-sub-pill').removeClass('active');

                // Add active class to clicked pill
                $(this).addClass('active');

                // Hide all content sections
                $('.content-section').hide();

                // Hide success factors alert by default
                $('#success-factors-alert').hide();

                // Show/hide sub-pills based on selection
                if (section === 'success-factors') {
                    console.log('Showing success factors');
                    $('#success-factors-subpills').slideDown(300);
                    $('#success-factors-alert').slideDown(300);

                    // Auto-select 3.1 Alignment
                    $('.diagnostic-sub-pill[data-section="alignment"]').addClass('active');
                    $('#content-alignment').show();
                } else {
                    console.log('Showing section:', section);
                    $('#success-factors-subpills').slideUp(300);
                    const contentId = '#content-' + section;
                    console.log('Content element:', contentId, $(contentId).length);
                    $(contentId).show();
                }
            });

            // Sub-pill navigation
            $('.diagnostic-sub-pill').on('click', function(e) {
                e.preventDefault();
                const section = $(this).data('section');
                console.log('Clicked sub-pill:', section);

                // Remove active class from all sub-pills
                $('.diagnostic-sub-pill').removeClass('active');

                // Add active class to clicked sub-pill
                $(this).addClass('active');

                // Hide all content sections
                $('.content-section').hide();

                // Show the selected content section
                const contentId = '#content-' + section;
                console.log('Showing content:', contentId);
                $(contentId).show();
            });
        });

        // Show/hide correct performance tiers based on server-side data
        $(document).ready(function() {
            var performanceTiers = {
                summary: '@ViewData["Summary"]',
                foundation: '@ViewData["Foundation"]',
                alignment: '@ViewData["Alignment"]',
                adoption: '@ViewData["Adoption"]',
                performance: '@ViewData["Performance"]',
                improvement: '@ViewData["Improvement"]',
                actionPlan: '@ViewData["ActionPlan"]'
            };

            console.log('Performance tiers:', performanceTiers);

            // Function to show correct performance tier for a section
            function showCorrectTier(sectionId, tier) {
                var $section = $('#content-' + sectionId);
                if ($section.length === 0) return;

                // Hide all options
                $section.find('.summary-option').hide();

                // Show the correct tier
                var $tierOption = $section.find('.summary-option[data-option="' + tier + '"]');
                if ($tierOption.length > 0) {
                    $tierOption.show();
                    console.log('Showing ' + tier + ' tier for ' + sectionId);
                } else {
                    // Fallback to high if tier not found
                    $section.find('.summary-option[data-option="high"]').show();
                    console.log('Tier not found for ' + sectionId + ', showing high as fallback');
                }
            }

            // Apply performance tiers to each section
            showCorrectTier('summary', performanceTiers.summary);
            showCorrectTier('foundation', performanceTiers.foundation);
            showCorrectTier('alignment', performanceTiers.alignment);
            showCorrectTier('adoption', performanceTiers.adoption);
            showCorrectTier('performance', performanceTiers.performance);
            showCorrectTier('improvement', performanceTiers.improvement);
            showCorrectTier('action', performanceTiers.actionPlan);
        });
    </script>
}
